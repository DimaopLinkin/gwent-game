  "fixed_sql": [
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"faction_id\" TEXT NOT NULL, \"leader_id\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "deck_cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"deck_cards\" (\"deck_id\" TEXT NOT NULL REFERENCES decks (id) ON DELETE CASCADE, \"card_id\" TEXT NOT NULL, \"copies\" INTEGER NOT NULL, PRIMARY KEY (\"deck_id\", \"card_id\"), CHECK (copies > 0));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "match_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"match_records\" (\"id\" TEXT NOT NULL, \"mode\" TEXT NOT NULL, \"player_faction_id\" TEXT NOT NULL, \"opponent_faction_id\" TEXT NOT NULL, \"opponent_name\" TEXT NULL, \"outcome\" TEXT NOT NULL, \"rounds_won\" INTEGER NOT NULL, \"rounds_lost\" INTEGER NOT NULL, \"finished_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
